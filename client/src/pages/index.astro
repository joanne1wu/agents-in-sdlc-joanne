---
import Layout from '../layouts/Layout.astro';
import GameList from '../components/GameList.svelte';
import "../styles/global.css";
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <!-- Hero Section with Enhanced Visual Appeal -->
  <div class="relative overflow-hidden">
    <!-- Background Gradient Mesh -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/20 via-purple-900/10 to-slate-900/5"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-blue-600/10 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_var(--tw-gradient-stops))] from-purple-600/10 via-transparent to-transparent"></div>
    
    <!-- Content -->
    <div class="relative z-10 py-16 px-4">
      <div class="max-w-6xl mx-auto text-center">
        <!-- Main Hero Content -->
        <div class="max-w-4xl mx-auto mb-16">
          <!-- Animated Badge -->
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-blue-500/10 to-purple-500/10 border border-blue-500/20 rounded-full mb-8 backdrop-blur-sm">
            <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            <span class="text-sm font-medium text-blue-300">Crowdfunding Platform</span>
          </div>
          
          <!-- Main Heading -->
          <h1 class="text-5xl md:text-7xl font-bold mb-6 bg-gradient-to-r from-slate-100 via-blue-200 to-purple-200 bg-clip-text text-transparent leading-tight">
            Welcome to<br>
            <span class="bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
              Tailspin Toys
            </span>
          </h1>
          
          <!-- Subtitle -->
          <p class="text-xl md:text-2xl text-slate-300 mb-8 leading-relaxed max-w-3xl mx-auto">
            Discover extraordinary <span class="text-blue-400 font-semibold">developer-themed board games</span> and help bring innovative gaming experiences to life through our crowdfunding platform.
          </p>
          
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
            <a href="#featured-games" class="group inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-full transition-all duration-300 transform hover:scale-105 hover:shadow-2xl hover:shadow-blue-500/25">
              <span>Explore Games</span>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a href="/about" class="group inline-flex items-center gap-2 px-8 py-4 bg-slate-800/60 hover:bg-slate-700/60 text-slate-300 hover:text-white font-semibold rounded-full border border-slate-600/50 hover:border-slate-500/50 transition-all duration-300 backdrop-blur-sm">
              <span>Learn More</span>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Stats Section -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <div class="text-center p-6 bg-slate-800/30 backdrop-blur-sm rounded-2xl border border-slate-700/50">
            <div class="text-3xl font-bold text-blue-400 mb-2">21+</div>
            <div class="text-slate-300">Exciting Games</div>
          </div>
          <div class="text-center p-6 bg-slate-800/30 backdrop-blur-sm rounded-2xl border border-slate-700/50">
            <div class="text-3xl font-bold text-purple-400 mb-2">DevOps</div>
            <div class="text-slate-300">Themed Adventures</div>
          </div>
          <div class="text-center p-6 bg-slate-800/30 backdrop-blur-sm rounded-2xl border border-slate-700/50">
            <div class="text-3xl font-bold text-green-400 mb-2">100%</div>
            <div class="text-slate-300">Fun Guaranteed</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Games Section -->
  <div class="py-16 px-4" id="featured-games">
    <div class="max-w-7xl mx-auto">
      <GameList client:only="svelte" />
    </div>
  </div>
</Layout>
