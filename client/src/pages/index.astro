---
import Layout from '../layouts/Layout.astro';
import GameList from '../components/GameList.svelte';
import "../styles/global.css";
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <!-- Enhanced Hero Section -->
  <div class="relative overflow-hidden">
    <!-- Animated Background Gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/20 via-purple-900/20 to-indigo-900/20"></div>
    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-900/10 via-transparent to-pink-900/10 animate-pulse"></div>
    
    <!-- Floating Orbs -->
    <div class="absolute top-20 left-10 w-32 h-32 bg-blue-500/10 rounded-full blur-xl animate-bounce"></div>
    <div class="absolute top-40 right-20 w-24 h-24 bg-purple-500/10 rounded-full blur-xl animate-pulse"></div>
    <div class="absolute bottom-20 left-1/4 w-40 h-40 bg-indigo-500/10 rounded-full blur-xl animate-bounce" style="animation-delay: 2s;"></div>
    
    <div class="relative py-16">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Enhanced Title with Gradient Text -->
        <h1 class="text-6xl md:text-7xl font-bold mb-6 bg-gradient-to-r from-blue-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent leading-tight">
          Welcome to 
          <span class="block bg-gradient-to-r from-cyan-300 via-blue-300 to-purple-300 bg-clip-text text-transparent">
            Tailspin Toys
          </span>
        </h1>
        
        <!-- Enhanced Subtitle -->
        <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed">
          Discover incredible <span class="text-blue-400 font-semibold">games</span> and 
          <span class="text-purple-400 font-semibold">back</span> the next big thing! 
          Explore our collection of developer-inspired gaming adventures.
        </p>
        
        <!-- Call to Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <button class="px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/25 transition-all duration-300 transform hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
            </svg>
            Start Exploring
          </button>
          <button class="px-8 py-4 border-2 border-slate-600 hover:border-blue-500 text-slate-300 hover:text-blue-400 font-semibold rounded-xl transition-all duration-300 transform hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Learn More
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Enhanced Games Section -->
  <div class="py-16 relative">
    <!-- Section Background -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-slate-900/50 to-transparent"></div>
    
    <div class="relative">
      <GameList client:only="svelte" />
    </div>
  </div>
</Layout>
